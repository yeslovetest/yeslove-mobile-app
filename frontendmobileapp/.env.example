# Local development. Store builds (eas build --profile preview|production) get
# EXPO_PUBLIC_API_BASE_URL from eas.json, so no chatbot URL is needed there.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5057
EXPO_PUBLIC_CHATBOT_BASE_URL=http://localhost:8000

# Browser sign-in (MFA stage 3). Off by default: the app keeps using the password form.
# Turn on only after the `yeslove-mobile` Keycloak client exists (KeyCloakService/scripts/mobile_client.py).
# EXPO_PUBLIC_BROWSER_SIGN_IN=true
# EXPO_PUBLIC_KEYCLOAK_URL=https://auth.yeslove.co.uk
# EXPO_PUBLIC_KEYCLOAK_REALM=YesLove_Auth
# EXPO_PUBLIC_KEYCLOAK_MOBILE_CLIENT_ID=yeslove-mobile
