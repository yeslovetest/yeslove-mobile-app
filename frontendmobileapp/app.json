{
  "expo": {
    "name": "Yeslove!",
    "slug": "yeslove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/yeslove-app-icon.png",
    "scheme": "yeslove",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.yeslove.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/yeslove-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "uk.co.yeslove.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/yeslove-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/yeslove-app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3aac3e1a-f92c-4ac3-ac9f-8c2b538fcc40"
      }
    }
  }
}
