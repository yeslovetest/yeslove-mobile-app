{
  "expo": {
    "name": "Yeslove!",
    "slug": "yeslove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/yeslove-app-icon.png",
    "scheme": "yeslove",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.yeslove.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/yeslove-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "uk.co.yeslove.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/yeslove-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/yeslove-app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Yeslove! to access your microphone to send voice messages in the chat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2d5be3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61181225-5460-45b4-b9a8-6a8255362c50"
      }
    },
    "owner": "yeslove-app"
  }
}
