            "name": "profile",
            "description": "API Endpoints"
        },
        {
            "name": "auth",
            "description": "API Endpoints"
        },
        {
            "name": "feed",
            "description": "API Endpoints"
        },
        {
            "name": "chat",
            "description": "API Endpoints"
        },
        {
            "name": "blog",
            "description": "API Endpoints"
        },
