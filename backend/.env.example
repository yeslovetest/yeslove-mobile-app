# Runtime
FLASK_ENV=production
SECRET_KEY=change-me

# Database (Supabase Postgres URL)
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.azjaazchwhcuibbrwlmf:4Q9i1562sfHaHuo7@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# JWT/Auth provider
AUTH_PROVIDER=auto
SUPABASE_URL=https://azjaazchwhcuibbrwlmf.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_ISSUER_URL=https://azjaazchwhcuibbrwlmf.supabase.co/auth/v1
JWT_JWKS_URL=https://azjaazchwhcuibbrwlmf.supabase.co/auth/v1/.well-known/jwks.json
PREFETCH_JWKS=true

# Keycloak fallback (used when AUTH_PROVIDER=keycloak, or auto fallback)
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM_NAME=YesLove_Auth
KEYCLOAK_CLIENT_ID=yeslove
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASS=
FRONTEND_URI=

# Redis (optional)
# Keep empty to run without Redis.
REDIS_URL=

# Media Settings
USE_S3_STORAGE=false
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10

# Optional services (leave empty when unused)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
FCM_SERVER_KEY=

# Security
UPLOAD_RATE_LIMIT=10