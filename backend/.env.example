# Database
DATABASE_URL=sqlite:///instance/dev.db

# Neo4j Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=testpassword

# Object Storage Configuration (optional)
OBJECT_STORAGE_PROVIDER=spaces
OBJECT_STORAGE_BUCKET=yeslove-media
OBJECT_STORAGE_REGION=lon1
OBJECT_STORAGE_ENDPOINT_URL=https://lon1.digitaloceanspaces.com
OBJECT_STORAGE_PUBLIC_URL=https://yeslove-media.lon1.digitaloceanspaces.com
OBJECT_STORAGE_ACCESS_KEY_ID=your_object_storage_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_object_storage_secret_key

# Media Settings
USE_S3_STORAGE=true
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10

# Queue Settings
QUEUE_PROVIDER=redis
QUEUE_NAME=yeslove:jobs
QUEUE_DLQ_NAME=yeslove:jobs:dlq
QUEUE_PENDING_NAME=yeslove:jobs:pending
QUEUE_DELAYED_NAME=yeslove:jobs:delayed
QUEUE_POLL_WAIT=20
QUEUE_MAX_RETRIES=5
QUEUE_WORKER_CONCURRENCY=4
QUEUE_REDIS_URL=redis://localhost:6379/0
QUEUE_RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
QUEUE_MAX_PRIORITY=10

# Push Notifications
FCM_SERVER_KEY=your_fcm_server_key

# Security
UPLOAD_RATE_LIMIT=10  # uploads per hour per user
