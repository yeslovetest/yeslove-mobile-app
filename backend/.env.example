# Runtime
FLASK_ENV=production
SECRET_KEY=change-me

# Database (Supabase Postgres URL)
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# JWT/Auth provider
AUTH_PROVIDER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
JWT_ISSUER_URL=https://<project-ref>.supabase.co/auth/v1
JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
PREFETCH_JWKS=true

# Redis (optional)
# Keep empty to run without Redis.
REDIS_URL=

# Media Settings
USE_S3_STORAGE=false
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10

# Optional services (leave empty when unused)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
FCM_SERVER_KEY=

# Security
UPLOAD_RATE_LIMIT=10