KEYCLOAK_CLIENT_ID=yeslove
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASS=
# Used for Supabase signup/recovery redirect_to and Keycloak email-action redirects.
# Must be added to Supabase Auth > URL Configuration allow list.
FRONTEND_URI=http://localhost:8081

# Redis (optional)
# Keep empty to run without Redis.
REDIS_URL=

# Media Settings
USE_S3_STORAGE=false
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10

# Optional services (leave empty when unused)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
FCM_SERVER_KEY=

# Security
UPLOAD_RATE_LIMIT=10